#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# transision from params file to flash-based params (2022-08)
if [ -f $PARAM_FILE ]
then
	param load $PARAM_FILE
	param save
	# create a backup
	mv $PARAM_FILE ${PARAM_FILE}.bak
	reboot
fi

param set-default BAT1_V_DIV 11.2
param set-default BAT1_A_PER_V 59.5

# system_power unavailable
param set-default CBRK_SUPPLY_CHK 894281

# use EKF2 without mag
param set-default SYS_HAS_MAG 1
# and enable gravity fusion
param set-default EKF2_IMU_CTRL 7

# the startup tune is not great on a binary output buzzer, so disable it
param set-default CBRK_BUZZER 782090

param set-default IMU_GYRO_RATEMAX 2000

# GPS1 module doesn't reliably support UBX (CFG-PRT ACKs but doesn't apply);
# it's NMEA-only, fixed at 115200 baud
param set-default GPS_1_PROTOCOL 6
param set-default SER_GPS1_BAUD 115200

# disable EKF2
param set EKF2_EN 0

# disable I2C probing
param set-default SENS_EXT_I2C_PRB 0

param set-default SDLOG_PROFILE 1

# Navputer bench rig (real hardware; see ROMFS/px4fmu_common/init.d/airframes/22001_sine_dwitch)
param set-default SYS_AUTOSTART 22001

# ----
# Navputer HW setup
param set-default NPT_RNGBC_CTRL 1
param set-default NPT_RNGBC_NOISE 75
param set-default NPT_GPS_INSTANCE 0
param set-default NPT_GPS_CTRL 7
param set-default NPT_SD_AUX_INST 1 # aux_global_position instance #0 (Beacon MLAT)

# Enable fusion of all NAVPUT sensors
param set-default NPT_FUSE_BARO 1
param set-default NPT_FUSE_MAG 1
param set-default NPT_FUSE_RNGBC 1
param set-default NPT_FUSE_AGP0 1
param set-default NPT_FUSE_GPS 1
param set-default NPT_FC_AGP_LATCH 5.0
param set-default NPT_FC_SD_EN 0

# Disable the battery/throttle magnetometer compensation
param set-default CAL_MAG_COMP_TYP 0
param set-default CAL_MAG0_ROT 2 # Yaw 90

# AGP is param driven, no per-instance levers
param set-default EKF2_AGP0_ID 111 # MLAT source
param set-default EKF2_AGP0_CTRL 1 # enable AGP (both EKF instances)
param set-default EKF2_AGP0_NOISE 250

# Logging
param set-default SDLOG_BACKEND 3 # SD + Mavlink
param set-default SDLOG_MODE 2 # from boot until shutdown
