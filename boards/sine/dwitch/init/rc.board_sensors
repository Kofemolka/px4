#!/bin/sh
#
# sine.dwitch specific board sensors init
#------------------------------------------------------------------------------
board_adc start

icm42688p -R 6 -s start

spa06 -X start

# AK09911C is not register-compatible with the AK09916 family, but its WIA2 ID
# is recognized (AK09916.cpp probe()) and forced onto the AK09916 read/scale
# path as the closest available driver.
ak09916 -X -a 0x0D start
